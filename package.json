{
  "name": "fuis18.github.io",
  "version": "1.0.0",
  "author": "Fuis18",
  "license": "MIT",
  "type": "module",
  "description": "My Website with Astro",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1"
  }
}
