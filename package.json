      "onFail": "download"
    }
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "7.0.2"
  }
