{
  "name": "fuis18.github.io",
  "version": "5.1.0",
  "author": "Fuis18",
  "license": "MIT",
  "type": "module",
  "description": "My Website with Astro",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "paraglide": "paraglide-js compile --emit-ts-declarations",
    "format": "prettier --write .",
    "pretest": "paraglide-js compile --emit-ts-declarations",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.29.3",
    "astro": "7.4.5",
    "vis-network": "10.1.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
