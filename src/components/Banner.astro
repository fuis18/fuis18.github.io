---
import homeDataRaw from "@/data/home.json";
import { withFallback } from "@/lib/i18n";
import type { Localized } from "@/types";

type HomeBlock = (typeof homeDataRaw)["en"];
const homeData = withFallback(
  homeDataRaw as unknown as Localized<HomeBlock>,
);
---

<div class="main-card">
  <h1>Luis Roman Cieza</h1>
  <div class="subtitle">
    {Object.entries(homeData).map(([lang, block]) => (
      <h2 data-lang={lang}>{block.role}</h2>
    ))}
    <span>/</span>
    <span>@fuis18</span>
  </div>
</div>

<style>
  h2 {
    display: inline;
    font-size: 1.5rem;
    color: var(--color);
  }
  .subtitle {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--color);
  }
  .subtitle span {
    font-size: 1.25rem;
  }
  @media screen and (width >= 640px) {
    h1 {
      font-size: 3.5rem;
    }
  }
  @media screen and (width >= 960px) {
    h1 {
      font-size: 4.5rem;
    }
  }
</style>
