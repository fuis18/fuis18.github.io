---
import type { Localized } from "@/types";
import { DEFAULT_LANG, getLang } from "@/lib/i18n";
import { m } from "@/paraglide/messages";

interface Props {
  slug: string;
  title: Localized<string>;
  description: Localized<string>;
  date: Localized<string>;
  isoDate: string;
  readingTime: Localized<number>;
  tags?: Localized<string[]>;
}

const {
  slug,
  title,
  description,
  date,
  isoDate,
  readingTime,
  tags = {},
} = Astro.props;

const pick = (localized: Localized<string>) =>
  localized[getLang()] ?? localized[DEFAULT_LANG];

const pickNumber = (localized: Localized<number>) =>
  localized[getLang()] ?? localized[DEFAULT_LANG] ?? 0;

const pickTags = (localized: Localized<string[]>) =>
  localized[getLang()] ?? localized[DEFAULT_LANG] ?? [];
---

<a href={`/blog/${slug}`} class="card-container card-content" data-size="sm">
  <div class="card-title">
    <h2 data-post-field="title" data-textfx>{pick(title)}</h2>
    <div class="card-tooltip">
      <time datetime={isoDate} data-post-field="date" data-textfx>
        {pick(date)}
      </time>
      <span data-post-field="reading-time" data-textfx>
        {m.blog_read_time({ minutes: pickNumber(readingTime) })}
      </span>
    </div>
  </div>

  <hr />
  <p data-post-field="description" data-textfx>{pick(description)}</p>
  <div class="tags" data-size="sm" data-post-field="tags">
    {pickTags(tags).map((tag) => <span class="tag">{tag}</span>)}
  </div>
</a>

<style>
  hr {
    min-width: 12rem;
    width: 50%;
  }
  .card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  h2 {
    font-size: 1.125rem;
  }
  .card-title {
    display: block;
  }
  @media screen and (width >= 700px) {
    .card-title {
      display: flex;
    }
  }
</style>
