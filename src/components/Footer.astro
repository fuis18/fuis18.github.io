---
import { SITE } from "@/consts";
---

<footer>
  <span
    >&copy; {new Date().getFullYear()} {SITE.AUTHOR}. All rights reserved.</span
  >
  <span>BUILD: RAW Astro & CSS</span>
</footer>

<style>
  footer {
    margin-inline: auto;
    padding: 1rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.875rem;
    align-items: center;
  }
  @media screen and (width >= 640px) {
    footer {
      flex-direction: row;
    }
  }
</style>
