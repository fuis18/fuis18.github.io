---
import { SITE, LINKS } from "@/consts";
// const { pathname } = Astro.url;
// const subpath = pathname.match(/[^/]+/g);

import LangDropdown from "./LangDropdown.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
  <div class="header-left">
    <a href="/" class="JP">{SITE.TITLE}</a>
    <span class="clock">00:00</span>
  </div>
  <!-- Center -->
  <nav>
    {LINKS.map((LINK) => <a href={LINK.HREF}>{LINK.TEXT}</a>)}
  </nav>
  <div class="header-rigth">
    <LangDropdown />
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
  }
  .header-left,
  .header-rigth {
    display: inherit;
    gap: 12px;
  }
  .clock {
    font-family: digital-7;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .JP {
    font-family: "Yuji Mai";
    font-weight: 700;
    font-size: 1.25rem;
  }
  nav {
    font-size: 0.875rem;
  }
  nav a {
    display: inline-block;
    margin: 0 1rem;
    height: 2.25rem;
    font-weight: 500;
    align-content: center;
  }
</style>
