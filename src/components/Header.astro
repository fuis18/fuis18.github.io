---
import { SITE, LINKS } from "@/consts";
const { pathname } = Astro.url;

import LangDropdown from "./LangDropdown.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
  <div class="header-left">
    <a href="/" class="JP">{SITE.TITLE}</a>
    <span class="clock">00:00</span>
  </div>
  <nav>
    {
      LINKS.map((LINK) => {
        const isActive =
          LINK.HREF === "/" ? pathname === "/" : pathname.startsWith(LINK.HREF);
        return (
          <a href={LINK.HREF} class:list={[{ active: isActive }]}>
            {Object.keys(LINK.TEXT).map((lang) => (
              <span data-lang={lang}>{LINK.TEXT[lang]}</span>
            ))}
          </a>
        );
      })
    }
  </nav>
  <div class="header-rigth">
    <LangDropdown />
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
  }
  .header-left {
    display: none;
  }
  .header-rigth {
    display: inherit;
  }
  .header-left,
  .header-rigth {
    gap: 12px;
    color: var(--color-title);
  }
  .clock {
    font-family: digital-7;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .JP {
    color: var(--color-title);
    font-family: "Yuji Mai";
    font-weight: 700;
    font-size: 1.25rem;
  }
  nav {
    font-size: 0.875rem;
    position: relative;
  }
  nav a {
    display: inline-block;
    margin-inline: 0.5rem;
    padding-inline: 1rem;
    height: 2.25rem;
    font-weight: 500;
    align-content: center;
    border-radius: 0.375rem;
    position: relative;
    z-index: 1;
  }
  nav a.active {
    background-color: var(--bg-hover);
    color: var(--color-title);
  }
  @media screen and (width >= 640px) {
    nav a {
      margin-inline: 1rem;
    }
    .header-left {
      display: inherit;
    }
  }
</style>

<script>
  function initIndicator() {
    const nav = document.querySelector("nav");
    const indicator = document.querySelector(".nav-indicator") as HTMLElement;
    const activeLink = nav?.querySelector(".active") as HTMLElement;
    if (!nav || !indicator || !activeLink) return;

    const navRect = nav.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();
    indicator.style.opacity = "1";
    indicator.style.left = linkRect.left - navRect.left + "px";
    indicator.style.width = linkRect.width + "px";
    indicator.style.height = linkRect.height + "px";
  }

  document.addEventListener("astro:page-load", initIndicator);
</script>
