---
import { SITE, LINKS } from "@/consts";
import { m } from "@/paraglide/messages";
const { pathname } = Astro.url;

import LangDropdown from "./LangDropdown.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header id="header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="JP">{SITE.TITLE}</a>
      <span class="clock">00:00</span>
    </div>
    <nav>
      {
        LINKS.map((LINK) => {
          const isActive =
            LINK.HREF === "/"
              ? pathname === "/"
              : pathname.startsWith(LINK.HREF);
          return (
            <a
              href={LINK.HREF}
              data-message={LINK.KEY}
              data-textfx
              class:list={[{ active: isActive }]}
            >
              {m[LINK.KEY]()}
            </a>
          );
        })
      }
    </nav>
    <div class="header-rigth">
      <LangDropdown />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      backdrop-filter 0.3s ease;
  }
  .header-inner {
    display: grid;
    padding-block: 0.75rem;
    gap: 0.5rem;
    grid-template:
      "hLeft hLeft hRigth" auto
      "hNav hNav hNav" auto;
    justify-content: center;
    align-items: center;
    min-height: 4rem;
  }
  header.scrolled {
    background-color: color-mix(in srgb, var(--bg-primary) 95%, transparent);
    border-bottom-color: var(--border);
    backdrop-filter: blur(12px);
  }
  @supports (backdrop-filter: blur(1px)) {
    header.scrolled {
      background-color: color-mix(in srgb, var(--bg-primary) 60%, transparent);
    }
  }
  .header-left {
    grid-area: hLeft;
  }
  .header-rigth {
    grid-area: hRigth;
  }
  .header-left,
  .header-rigth {
    display: inline-flex;
    gap: 12px;
    color: var(--color-title);
    align-items: center;
  }
  .clock {
    font-family: digital-7;
    font-size: 1.5rem;
    line-height: 1.8;
  }
  .JP {
    color: var(--color-title);
    font-family: "Yuji Mai";
    font-weight: 700;
    font-size: 1.25rem;
  }
  nav {
    font-size: 0.875rem;
    position: relative;
    grid-area: hNav;
  }
  nav a {
    display: inline-block;
    margin-inline: 0.5rem;
    padding-inline: 0.5rem;
    height: 2.25rem;
    font-weight: 500;
    align-content: center;
    border-radius: 0.375rem;
    position: relative;
    z-index: 1;
  }
  nav a.active {
    background-color: var(--bg-hover);
    color: var(--color-title);
  }

  @media screen and (width >= 350px) {
    nav a {
      padding-inline: 1rem;
    }
  }
  @media screen and (width >= 650px) {
    .header-inner {
      grid-template: "hLeft hNav hRigth" auto;
      justify-content: space-between;
    }
  }
  @media screen and (width >= 960px) {
    nav a {
      margin-inline: 1rem;
    }
  }
</style>

<script>
  import { m } from "@/paraglide/messages";
  import { syncOnLangChange } from "@/lib/i18n";

  const addZeros = (n: number): string => {
    return n.toString().length < 2 ? `0${n}` : n.toString();
  };

  function initClock() {
    const clock = document.querySelector(".clock");
    if (!clock) return;

    const update = () => {
      const now = new Date();
      clock.textContent = `${addZeros(now.getHours())}:${addZeros(now.getMinutes())}`;
    };

    update();
    setInterval(update, 1000);
  }

  function initIndicator() {
    const nav = document.querySelector("nav");
    const indicator = document.querySelector(".nav-indicator") as HTMLElement;
    const activeLink = nav?.querySelector(".active") as HTMLElement;
    if (!nav || !indicator || !activeLink) return;

    const navRect = nav.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();
    indicator.style.opacity = "1";
    indicator.style.left = linkRect.left - navRect.left + "px";
    indicator.style.width = linkRect.width + "px";
    indicator.style.height = linkRect.height + "px";
  }

  function syncNav() {
    const messages: Record<string, () => string> = {
      nav_home: m.nav_home,
      nav_projects: m.nav_projects,
      nav_blog: m.nav_blog,
    };
    document
      .querySelectorAll<HTMLAnchorElement>("[data-message]")
      .forEach((a) => {
        const key = a.dataset.message ?? "";
        const message = messages[key];
        if (typeof message === "function") a.textContent = message();
      });
  }

  function handleScroll() {
    const header = document.getElementById("header");
    if (header) header.classList.toggle("scrolled", window.scrollY > 0);
  }

  function setupScrollHandler() {
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  syncOnLangChange(syncNav);
  document.addEventListener("astro:page-load", setupScrollHandler);
  document.addEventListener("astro:page-load", syncNav);
  document.addEventListener("astro:page-load", initClock);
  document.addEventListener("astro:page-load", initIndicator);
</script>
