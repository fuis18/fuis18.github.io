---
import homeData from "@/data/home.json";

const links = [
  { label: "Mail", url: "mailto:fuis18@proton.me" },
  { label: "GitHub", url: "https://github.com/fuis18" },
  { label: "LinkedIn", url: "https://linkedin.com/in/fuis18" },
  { label: "Youtube", url: "https://youtube.com/@fuis18" },
  { label: "Ko-fi", url: "https://ko-fi.com/fuis18" },
  { label: "Signal", url: "" },
];
---

<div class="card-container">
  <div class="card__modes">
    <div>HR</div>
    <div>HF</div>
  </div>
  <div class="card__about card-content">
    <h3 data-lang="es">{homeData.es.about.title}</h3>
    <h3 data-lang="en">{homeData.en.about.title}</h3>
    <p data-lang="es">{homeData.es.about.text}</p>
    <p data-lang="en">{homeData.en.about.text}</p>
  </div>
  <div class="card__links">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.url} target="_blank">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .card-container {
    display: grid;
    grid-template-areas:
      "modes about"
      "links links";
    grid-template-columns: min-content 1fr;
    grid-template-rows: auto auto;
  }
  .card__modes {
    grid-area: modes;
  }
  .card__modes div {
    padding: 2px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .card__about {
    grid-area: about;
  }
  .card__links {
    grid-area: links;
    border-top: 1px solid var(--color-border);
  }
  .card__links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .card__links li {
    padding: 4px 0;
  }
  .card__links a {
    color: var(--color-text);
    text-decoration: none;
  }
  .card__links a:hover {
    text-decoration: underline;
  }

  @media screen and (width >= 768px) {
    .card-container {
      grid-template-areas: "modes about links";
      grid-template-columns: min-content 2fr 1fr;
    }
    .card__links {
      border-top: none;
      border-left: 1px solid var(--color-border);
    }
  }
</style>


