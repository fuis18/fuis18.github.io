---
import homeData from "@/data/home.json";
import MailIcon from "@/assets/mail.svg";
import GithubIcon from "@/assets/github.svg";
import LinkedinIcon from "@/assets/linkedin.svg";
import YoutubeIcon from "@/assets/youtube.svg";
import KofiIcon from "@/assets/ko-fi.svg";
import SignalIcon from "@/assets/signal.svg";
import ListOutlineIcon from "@/assets/list-outline.svg";
import NodesIcon from "@/assets/nodes.svg";

const links = [
  { label: "Mail", url: "mailto:fuis18@proton.me", icon: MailIcon },
  { label: "GitHub", url: "https://github.com/fuis18", icon: GithubIcon },
  {
    label: "LinkedIn",
    url: "https://linkedin.com/in/fuis18",
    icon: LinkedinIcon,
  },
  { label: "Youtube", url: "https://youtube.com/@fuis18", icon: YoutubeIcon },
  { label: "Ko-fi", url: "https://ko-fi.com/fuis18", icon: KofiIcon },
  { label: "Signal", url: "", icon: SignalIcon },
];
---

<div class="card-container">
  <div class="card__modes">
    <div><ListOutlineIcon /></div>
    <div><NodesIcon /></div>
  </div>
  <div class="card__about card-content">
    <h3 data-lang="es">{homeData.es.about.title}</h3>
    <h3 data-lang="en">{homeData.en.about.title}</h3>
    <p data-lang="es">{homeData.es.about.text}</p>
    <p data-lang="en">{homeData.en.about.text}</p>
  </div>
  <ul class="card__links">
    {
      links.map((link) => (
        <li>
          <a href={link.url} target="_blank" aria-label={link.label}>
            <link.icon />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .card-container {
    display: grid;
    grid-template-areas:
      "modes about"
      "links links";
    grid-template-columns: min-content 1fr;
    grid-template-rows: auto auto;
  }
  .card__modes {
    grid-area: modes;
  }
  .card__modes div {
    padding: 6px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card__modes svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  .card__about {
    grid-area: about;
  }
  h3 {
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .card__links {
    grid-area: links;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .card__links {
    list-style: none;
  }
  .card__links li {
    border-bottom: 1px solid var(--border);
  }
  .card__links li:hover {
    background-color: var(--bg-secondary);
  }
  .card__links a {
    color: var(--color);
    fill: var(--color);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 1.5rem 2rem;
  }
  .card__links a:hover {
    color: var(--color-hover);
    fill: var(--color-hover);
  }
  .card__links svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .card__links li:nth-child(2n) {
    border-left: 1px solid var(--border);
  }

  .card__links li:nth-child(5),
  .card__links li:nth-child(6) {
    border-bottom: none;
  }

  @media screen and (width >= 640px) {
    p {
      font-size: 1.125rem;
    }
  }

  @media screen and (width >= 768px) {
    .card-container {
      grid-template-areas: "modes about links";
      grid-template-columns: min-content 3fr min-content;
    }
    .card__links {
      border-top: none;
      border-left: 1px solid var(--border);
    }
    .card__links li:nth-child(2) {
      border-top-right-radius: 1rem;
    }
    .card__links :nth-child(6) {
      border-bottom-right-radius: 1rem;
    }
  }
</style>
