---
import homeDataRaw from "@/data/home.json";
import { pickLocalized } from "@/lib/i18n";
import type { Localized } from "@/types";
import SkillGraph from "./SkillGraph.astro";
import MailIcon from "@/assets/svg-links/mail.svg";
import GithubIcon from "@/assets/svg-links/github.svg";
import LinkedinIcon from "@/assets/svg-links/linkedin.svg";
import YoutubeIcon from "@/assets/svg-links/youtube.svg";
import KofiIcon from "@/assets/svg-links/ko-fi.svg";
import SignalIcon from "@/assets/svg-links/signal.svg";
import ListOutlineIcon from "@/assets/svg-tools/list-outline.svg";
import NodesIcon from "@/assets/svg-tools/nodes.svg";

type HomeBlock = (typeof homeDataRaw)["en"];
const homeData = homeDataRaw as unknown as Localized<HomeBlock>;

const links = [
  { label: "Mail", url: "mailto:fuis18@proton.me", icon: MailIcon },
  { label: "GitHub", url: "https://github.com/fuis18", icon: GithubIcon },
  {
    label: "LinkedIn",
    url: "https://linkedin.com/in/fuis18",
    icon: LinkedinIcon,
  },
  { label: "Youtube", url: "https://youtube.com/@fuis18", icon: YoutubeIcon },
  { label: "Ko-fi", url: "https://ko-fi.com/fuis18", icon: KofiIcon },
  { label: "Signal", url: "", icon: SignalIcon },
];
---

<div class="card-wrap">
  <!-- Legenda del borde: HERMANO del contenedor (el clip-path no la recorta).
       Antes del contenedor en el DOM para mantener el orden de lectura; z-index
       la pinta por encima del fondo del contenedor. -->
  <h3 class="card__legend" data-i18n="about-title" data-textfx>
    {pickLocalized(homeData).about.title}
  </h3>

  <div class="card-container">
    <div class="card-container-content">
      <div class="card__modes">
        <button
          id="mode-list"
          type="button"
          class="is-active"
          aria-label="List mode"
          aria-pressed="true"
        >
          <ListOutlineIcon />
        </button>
        <button
          id="mode-nodes"
          type="button"
          aria-label="Graph mode"
          aria-pressed="false"
        >
          <NodesIcon />
        </button>
      </div>
      <div class="card-content">
        <div class="card__content-text">
          <p data-i18n="about-text" data-textfx>
            {pickLocalized(homeData).about.text}
          </p>
        </div>
        <SkillGraph />
      </div>
    </div>
    <ul class="card__links">
      {
        links.map((link) => (
          <li>
            <a href={link.url} target="_blank" aria-label={link.label}>
              <link.icon />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import homeDataRaw from "@/data/home.json";
  import {
    GRAPH_MODE_EVENT,
    pickLocalized,
    syncOnLangChange,
  } from "@/lib/i18n";
  import type { Localized } from "@/types";

  type Mode = "about" | "graph";
  type HomeBlock = (typeof homeDataRaw)["en"];

  let wrap: HTMLElement | null = null;
  let container: HTMLElement | null = null;
  let listBtn: HTMLButtonElement | null = null;
  let graphBtn: HTMLButtonElement | null = null;
  let legend: HTMLElement | null = null;
  let links: HTMLElement | null = null;
  let mode: Mode = "about";
  let observer: ResizeObserver | null = null;
  let resizeBound = false;

  function syncAbout() {
    const homeData = homeDataRaw as unknown as Localized<HomeBlock>;
    const about = pickLocalized(homeData).about;
    const title = document.querySelector<HTMLElement>(
      "[data-i18n='about-title']",
    );
    const text = document.querySelector<HTMLElement>(
      "[data-i18n='about-text']",
    );
    if (title) title.textContent = about.title;
    if (text) text.textContent = about.text;
  }

  syncOnLangChange(syncAbout);
  document.addEventListener("astro:page-load", syncAbout);

  function dispatchGraphMode(active: boolean) {
    document.dispatchEvent(
      new CustomEvent(GRAPH_MODE_EVENT, { detail: { active } }),
    );
  }

  /**
   * Dimensiona la muesca del borde con el box real de la legenda y alinea la
   * legenda con el inicio del texto (--legend-x). Las variables se escriben
   * en el WRAP: las leen el clip-path del contenedor (por herencia) y el
   * parche del hueco (.card-wrap::before).
   */
  function measureLegend() {
    if (!container || !wrap || !legend) return;
    const wRect = wrap.getBoundingClientRect();
    const lRect = legend.getBoundingClientRect();
    const margin = 10;
    const x1 = Math.max(0, lRect.left - wRect.left - margin);
    const x2 = lRect.right - wRect.left + margin;
    if (x2 > x1) {
      wrap.style.setProperty("--notch-x1", `${x1}px`);
      wrap.style.setProperty("--notch-x2", `${x2}px`);
    }
    // El texto solo está en flujo en modo about; no medir si está oculto.
    const text = document.querySelector<HTMLElement>(
      "[data-i18n='about-text']",
    );
    if (text && text.offsetParent !== null) {
      const tRect = text.getBoundingClientRect();
      wrap.style.setProperty("--legend-x", `${tRect.left - wRect.left}px`);
    }
  }

  function setMode(next: Mode) {
    mode = next;
    if (!container || !listBtn || !graphBtn || !wrap) return;

    container.classList.toggle("graph-mode", next === "graph");
    wrap.classList.toggle("graph-mode", next === "graph");
    listBtn.classList.toggle("is-active", next === "about");
    graphBtn.classList.toggle("is-active", next === "graph");
    listBtn.setAttribute("aria-pressed", String(next === "about"));
    graphBtn.setAttribute("aria-pressed", String(next === "graph"));

    dispatchGraphMode(next === "graph");
    // Diferir la medida al siguiente frame: los classList.toggle de arriba
    // invalidan el layout; leer rects aquí forzaría un reflow síncrono.
    requestAnimationFrame(() => measureLegend());
  }

  function setup() {
    wrap = document.querySelector(".card-wrap");
    container = document.querySelector(".card-container");
    links = document.querySelector(".card__links");
    listBtn = document.getElementById("mode-list") as HTMLButtonElement;
    graphBtn = document.getElementById("mode-nodes") as HTMLButtonElement;
    legend = document.querySelector(".card__legend");

    if (!wrap || !container || !listBtn || !graphBtn || !legend) return;
    if (mode !== "about") setMode("about");
    measureLegend();

    observer?.disconnect();
    observer = null;
    if (typeof ResizeObserver !== "undefined") {
      observer = new ResizeObserver(() => measureLegend());
      observer.observe(legend);
    }
    if (!resizeBound) {
      resizeBound = true;
      window.addEventListener("resize", measureLegend);
      document.fonts?.ready?.then(() => measureLegend());
    }

    listBtn.addEventListener("click", () => setMode("about"));
    graphBtn.addEventListener("click", () => setMode("graph"));
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .card-wrap {
    position: relative;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --card-bg: var(--bg-secondary);
    --notch-depth: 1px;
    --notch-x1: 12px;
    --notch-x2: 160px;
    --legend-x: 4rem;
    --title-fs: 0.875rem;
    --title-lh: 1.8;
    --title-line-center: calc((var(--title-fs) * var(--title-lh)) / 2);
    --title-shift: calc(2rem + var(--title-line-center));
  }

  /* El contenedor cambia de fondo al hover; el parche del hueco lo sigue. */
  .card-wrap:has(.card-container:hover) {
    --card-bg: var(--bg-primary);
  }

  /* Parche del hueco: detrás del contenedor, solo visible a través del
     corte físico del clip-path → el hueco tiene el color del contenedor. */
  .card-wrap::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--notch-x1);
    width: calc(var(--notch-x2) - var(--notch-x1));
    height: var(--notch-depth);
    background: var(--card-bg);
    pointer-events: none;
  }

  .card-container {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    /* Modo about (estado base): borde continuo (muesca colapsada). Cierra
       a la vez que la legenda baja al interior. */
    clip-path: polygon(
      0 0,
      calc((var(--notch-x1) + var(--notch-x2)) / 2) 0,
      calc((var(--notch-x1) + var(--notch-x2)) / 2) 0,
      calc((var(--notch-x1) + var(--notch-x2)) / 2) 0,
      calc((var(--notch-x1) + var(--notch-x2)) / 2) 0,
      100% 0,
      100% 100%,
      0 100%
    );
    transition: clip-path 0.3s var(--ease);
  }

  .card-wrap.graph-mode .card-container {
    /* Modo graph: muesca abierta (la línea superior se interrumpe como en
       un <legend>). Abre al mismo tiempo que la legenda asciende. */
    clip-path: polygon(
      0 0,
      var(--notch-x1) 0,
      var(--notch-x1) var(--notch-depth),
      var(--notch-x2) var(--notch-depth),
      var(--notch-x2) 0,
      100% 0,
      100% 100%,
      0 100%
    );
    transition: clip-path 0.2s var(--ease);
  }

  /* Legenda: centro vertical sobre la línea del borde. En modo about baja
     al interior (translateY) y en graph sube al borde; ambas se animan a la
     vez que el borde se abre o se cierra. */
  .card__legend {
    position: absolute;
    top: calc(1px - var(--title-line-center));
    left: var(--legend-x);
    z-index: 1;
    font-size: var(--title-fs);
    line-height: var(--title-lh);
    color: var(--color-title);
    background: transparent;
    pointer-events: none;
    white-space: nowrap;
    transform: translateY(var(--title-shift));
    transition: transform 0.3s var(--ease);
  }

  .card-wrap.graph-mode .card__legend {
    transform: translateY(0);
    transition: transform 0.2s var(--ease);
  }

  .card-container:hover .card__modes button {
    background-color: var(--bg-primary);
  }

  .card-container:hover .card__modes button.is-active {
    background-color: var(--bg-hover);
  }

  .card-container-content {
    display: flex;
  }
  .card__modes {
    grid-area: modes;
  }
  .card__modes button {
    padding: 6px;
    border: none;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: var(--bg-secondary);
    color: var(--color);
    font: inherit;
    line-height: 1;
  }
  .card__modes button:nth-child(1) {
    border-top-left-radius: 1rem;
  }
  .card__modes button:hover,
  .card__modes button.is-active {
    background-color: var(--bg-hover);
    color: var(--color-hover);
  }
  .card__modes svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  .card__content {
    grid-area: about;
  }
  .card__content-text {
    display: block;
    /* Despeja la legenda posicionada dentro del contenedor (modo about). */
    margin-top: calc(var(--title-line-center) * 2 + 1rem);
  }
  h3 {
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .card-container.graph-mode .card__content-text {
    display: none;
  }
  .card-container.graph-mode .card-content {
    padding: 1.25rem 0 0;
    flex: 1;
  }
  .card-container.graph-mode .card-container-content {
    position: relative;
  }
  .card-container.graph-mode .card__modes {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    border-top-left-radius: 1rem;
  }
  .card__links {
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .card__links {
    list-style: none;
  }
  .card__links li {
    border-bottom: 1px solid var(--border);
  }
  .card__links li:hover {
    background-color: var(--bg-secondary);
  }
  .card__links a {
    color: var(--color);
    fill: var(--color);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 1.5rem 2rem;
  }
  .card__links a:hover {
    color: var(--color-hover);
    fill: var(--color-hover);
  }
  .card__links svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .card__links li:nth-child(2n) {
    border-left: 1px solid var(--border);
  }

  .card__links li:nth-child(5),
  .card__links li:nth-child(6) {
    border-bottom: none;
  }

  @media screen and (width >= 640px) {
    p {
      font-size: 1.125rem;
    }
  }

  @media screen and (width >= 760px) {
    .card-container {
      grid-template-areas: "modes about links";
      grid-template-columns: 3fr min-content;
    }
    .card__links {
      border-top: none;
      border-left: 1px solid var(--border);
    }
    .card__links li:nth-child(2) {
      border-top-right-radius: 1rem;
    }
    .card__links :nth-child(6) {
      border-bottom-right-radius: 1rem;
    }
    .card-container.graph-mode .card__links {
      grid-template-columns: 1fr;
    }
    .card-container.graph-mode .card__links li:nth-child(2n) {
      border-left: none;
    }
    .card-container.graph-mode .card__links li:nth-child(5) {
      border-bottom: 1px solid var(--border);
    }
    .card-container.graph-mode .card__links li:first-child {
      border-top-right-radius: 1rem;
    }
    .card-container.graph-mode .card__links li:nth-child(2) {
      border-top-right-radius: 0;
    }
  }

  /* Sin animación si el usuario la desactiva. */
  @media (prefers-reduced-motion: reduce) {
    .card-container,
    .card__legend {
      transition: none;
    }
  }
</style>