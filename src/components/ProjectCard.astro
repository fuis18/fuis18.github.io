---
import type { ImageMetadata } from "astro";
import type { Localized } from "@/types";
import ImageZoom from "./ImageZoom.astro";
import Web from "@/assets/svg-tools/web.svg";

interface Props {
  title: Localized<string>;
  description: Localized<string>;
  repo?: string;
  website?: string | null;
  image?: ImageMetadata;
  tags?: string[];
  date: Localized<string>;
}

const { title, description, repo = "/", website, image, tags = [], date } = Astro.props;

const langs = Object.keys(title);
const alt = Object.values(title)[0] ?? "";
---

<div class="card-container project-card">
  {image && <ImageZoom src={image} alt={alt} />}
  <a href={repo} class="card-content" target="_blank">
    <div class="project-title">
      {website ? (
        <a href={website} target="_blank" aria-label="Web" class="web-icon"><Web /></a>
      ) : (
        <Web />
      )}
      {langs.map((lang) => <h2 data-lang={lang}>{title[lang]}</h2>)}
      {langs.map((lang) => <span data-lang={lang}>{date[lang]}</span>)}
    </div>
    {langs.map((lang) => <p data-lang={lang}>{description[lang]}</p>)}
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </a>
</div>

<style>
  .project-card {
    position: relative;
    display: grid;
    transition-property: translate;
    transition-duration: 0.2s;
    overflow: hidden;
    grid-template-rows: min-content 1fr;
  }

  .project-card:hover {
    translate: 0 -0.25rem;
  }
  .project-card:hover .tag {
    color: var(--color-hover);
    background-color: var(--bg-secondary);
  }

  html.dark .project-card {
    border-left: none;
    border-right: none;
    border-radius: initial;
  }

  html.dark .project-card:hover::before {
    content: "";
    position: absolute;
    top: 0;
    left: -70%;
    height: 100%;
    width: 5rem;
    pointer-events: none;
    animation: shine 2s;
    background-color: var(--color-title);
    opacity: 0.1;
    transform: skewX(-25deg);
  }

  .card-content {
    width: 100%;
    padding: 1rem;
    display: grid;
    grid-template-rows: min-content 1fr min-content;
  }
  .project-content {
    width: 100%;
  }
  .project-title {
    display: grid;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    grid-template-columns: min-content 1fr min-content;
    gap: 0.5rem;
  }
  h2 {
    font-size: 1.125rem;
  }
  .project-title span {
    font-size: 0.75rem;
    width: max-content;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .web-icon {
    display: flex;
  }
  .tag {
    border: 1px solid var(--border);
    border-radius: 1rem;
    white-space: nowrap;
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
  }

  @keyframes shine {
    0% {
      left: -20%;
      filter: blur(10px);
    }
    50% {
      filter: blur(0px);
    }
    100% {
      left: 110%;
      filter: blur(10px);
    }
  }
  @media screen and (width >= 670px) {
    .project-title {
      grid-template-columns: min-content 1fr;
    }
    .project-title span {
      grid-column: 1 / 3;
    }
  }
  @media screen and (width >= 860px) {
    .project-title {
      grid-template-columns: min-content 1fr min-content;
    }
    .project-title span {
      grid-column: initial;
    }
  }
  @media screen and (width >= 1010px) {
    .project-title {
      grid-template-columns: min-content 1fr;
    }
    .project-title span {
      grid-column: 1 / 3;
    }
  }
  @media screen and (width >= 1400px) {
    .project-card {
      width: 60%;
      grid-template-columns: 2fr 3fr;
    }
    .project-title {
      grid-template-columns: min-content 1fr min-content;
    }
    .project-title span {
      grid-column: initial;
    }
  }
  @media screen and (width >= 1720px) {
    .project-card {
      width: 100%;
    }
  }
</style>
