---
import type { Localized } from "@/types";
import { DEFAULT_LANG, getLang } from "@/lib/i18n";
import Web from "@/assets/svg-tools/web.svg";

interface Props {
  title: Localized<string>;
  description: Localized<string>;
  repo?: string;
  website?: string | null;
  tags?: string[];
  date: Localized<string>;
}

const {
  title,
  description,
  repo = "/",
  website,
  tags = [],
  date,
} = Astro.props;
---

<div class="card-container project-card">
  <div class="card-content" data-repo={repo} role="link" tabindex="0">
    <div class:list={["project-title", website ? "has-web" : "no-web"]}>
      {
        website && (
          <a href={website} target="_blank" aria-label="Web" class="web-icon">
            <Web />
          </a>
        )
      }
      <h2 data-project-field="title">{title[getLang()] ?? title[DEFAULT_LANG]}</h2>
      <span data-project-field="date">{date[getLang()] ?? date[DEFAULT_LANG]}</span>
    </div>
    <p data-project-field="description">
      {description[getLang()] ?? description[DEFAULT_LANG]}
    </p>
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</div>

<style>
  .project-card {
    position: relative;
    display: grid;
    transition-property: translate;
    transition-duration: 0.2s;
    overflow: hidden;
  }

  .project-card:hover .tag {
    color: var(--color-hover);
    background-color: var(--bg-secondary);
  }

  html.light .project-card {
    border: none;
  }

  .project-card {
    border-left: none;
    border-right: none;
    border-radius: initial;
  }

  .project-card:hover::before {
    content: "";
    position: absolute;
    top: 0;
    left: -70%;
    height: 100%;
    width: 5rem;
    pointer-events: none;
    animation: shine 2s;
    background-color: var(--color-title);
    opacity: 0.1;
    transform: skewX(-25deg);
  }

  .card-content {
    width: 100%;
    padding: 1rem;
    display: grid;
    grid-template-rows: min-content 1fr min-content;
    cursor: pointer;
  }
  .project-content {
    width: 100%;
  }
  .project-title {
    display: grid;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .project-title.no-web {
    grid-template-columns: 1fr min-content;
  }
  .project-title.has-web {
    grid-template-columns: min-content 1fr min-content;
  }
  h2 {
    font-size: 1.125rem;
  }
  .project-title span {
    font-size: 0.75rem;
    width: max-content;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .web-icon {
    display: flex;
    transition: transform 0.2s ease;
  }
  .web-icon:hover {
    transform: rotate(12deg) scale(1.1);
  }
  .tag {
    border: 1px solid var(--border);
    border-radius: 1rem;
    white-space: nowrap;
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
  }

  @keyframes shine {
    0% {
      left: -20%;
      filter: blur(10px);
    }
    50% {
      filter: blur(0px);
    }
    100% {
      left: 110%;
      filter: blur(10px);
    }
  }
  @media screen and (width >= 670px) {
    .project-title.has-web {
      grid-template-columns: min-content 1fr;
    }
    .project-title.has-web span {
      grid-column: 1 / 3;
    }
  }
  @media screen and (width >= 860px) {
    .project-title.has-web {
      grid-template-columns: min-content 1fr min-content;
    }
    .project-title.has-web span {
      grid-column: initial;
    }
  }
  @media screen and (width >= 1010px) {
    .project-title.has-web {
      grid-template-columns: min-content 1fr;
    }
    .project-title.has-web span {
      grid-column: 1 / 3;
    }
  }
  @media screen and (width >= 1400px) {
    .project-title.has-web {
      grid-template-columns: min-content 1fr min-content;
    }
    .project-title.has-web span {
      grid-column: initial;
    }
  }
</style>

<script>
  function setup() {
    document.querySelectorAll<HTMLElement>(".card-content").forEach((el) => {
      if (el.dataset.setup) return;
      el.dataset.setup = "true";

      const navigate = () => {
        const url = el.dataset.repo;
        if (!url) return;
        const a = document.createElement("a");
        a.href = url;
        a.target = "_blank";
        a.rel = "noopener";
        document.body.appendChild(a);
        a.click();
        a.remove();
      };

      el.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) return;
        navigate();
      });

      el.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          navigate();
        }
      });
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
