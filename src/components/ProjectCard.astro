---
import ImageZoom from "./ImageZoom.astro";

interface Props {
  title: string;
  description?: string;
  href?: string;
  image?: string;
  tags?: string[];
}

const { title, description = "", href = "/", image, tags = [] } = Astro.props;
---

<div class="card-container project-card">
  {image && <ImageZoom src={image} alt={title} />}
  <a href={href} class="card-content">
    <div class="project-title">
      <h2>{title}</h2><span>2025 - 2026</span>
    </div>
    <p>{description}</p>
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </a>
</div>

<style>
  .project-card {
    position: relative;
    display: grid;
    transition-property: translate;
    transition-duration: 0.2s;
    overflow: hidden;
  }

  .project-card:hover {
    translate: 0 -0.25rem;
  }
  .project-card:hover .tag {
    color: var(--color-hover);
    background-color: var(--bg-secondary);
  }

  html.dark .project-card {
    border-left: none;
    border-right: none;
    border-radius: initial;
  }

  html.dark .project-card:hover::before {
    content: "";
    position: absolute;
    top: 0;
    left: -70%;
    height: 100%;
    width: 5rem;
    pointer-events: none;
    animation: shine 2s;
    background-color: var(--color-title);
    opacity: 0.1;
    transform: skewX(-25deg);
  }

  .card-content {
    width: 100%;
    padding: 1rem;
    display: grid;
    grid-template-rows: min-content 1fr min-content;
  }
  .project-content {
    width: 100%;
  }
  .project-title {
    display: inline-flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }
  h2 {
    font-size: 1.125rem;
  }
  .project-title span {
    font-size: 0.75rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .tag {
    border: 1px solid var(--border);
    border-radius: 1rem;
    white-space: nowrap;
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
  }

  @keyframes shine {
    0% {
      left: -20%;
      filter: blur(10px);
    }
    50% {
      filter: blur(0px);
    }
    100% {
      left: 110%;
      filter: blur(10px);
    }
  }
  @media screen and (width >= 900px) {
    .project-card {
      grid-template-columns: 2fr 3fr;
    }
  }
  @media screen and (width >= 1150px) {
    .project-card {
      width: 75%;
    }
  }
  @media screen and (width >= 1720px) {
    .project-card {
      width: 100%;
    }
  }
</style>
