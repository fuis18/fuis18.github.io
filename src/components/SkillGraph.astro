<div class="skill-graph">
  <div id="network" class="card__network"></div>
  <aside id="network-info" class="card__network-info" hidden>
    <button type="button" id="network-info-close" aria-label="Close">×</button>
    <h4 id="network-info-title"></h4>
    <p id="network-info-text"></p>
  </aside>
</div>

<script>
  import graph from "@/data/graph.json";
  import { resolveBadges, tintForTheme, toDataUri } from "@/lib/badges";
  import { GRAPH_MODE_EVENT } from "@/lib/events";
  import { pickLocalized, syncOnLangChange } from "@/lib/i18n";
  import type { Localized } from "@/types";
  import type { DataSet, Edge, Network } from "vis-network/standalone";

  interface GraphNode {
    id: string;
    label: string;
    group: "center" | "category" | "skill";
    badge?: string;
    description?: Localized<string>;
  }

  /** Nodo con la descripción resuelta al idioma activo (el que vive en el DataSet). */
  type ResolvedGraphNode = Omit<GraphNode, "description"> & {
    description?: string;
    shape?: "image";
    image?: string;
  };

  let network: Network | null = null;
  let nodesDataSet: DataSet<ResolvedGraphNode> | null = null;
  let ensurePromise: Promise<void> | null = null;
  let controller: AbortController | null = null;
  let infoEl: HTMLElement | null = null;
  let infoTitle: HTMLElement | null = null;
  let infoText: HTMLElement | null = null;
  let currentInfoId: string | null = null;

  const rawNodes = graph.nodes as GraphNode[];

  const badgeFiles = import.meta.glob("@/assets/svg-badges/*.svg", {
    eager: true,
    query: "?raw",
    import: "default",
  }) as Record<string, string>;
  const badgeAssets = resolveBadges(badgeFiles);

  /** Estado de cada nodo con badge: URIs y variante activa (base | hover). */
  const badgeState: Record<
    string,
    { base: string; hover: string; active: "base" | "hover" }
  > = {};

  /** Nodos con badge marcados en hover por selección (no por hover de ratón). */
  const selectedBadgeIds = new Set<string>();

  function currentTint(): string {
    return tintForTheme(document.documentElement.classList.contains("dark"));
  }

  /**
   * Variantes de un badge según el tema:
   * - Tema light: reposo a color y hover/active monocromático tintado.
   * - Tema dark: reposo monocromático tintado y hover/active a color.
   */
  function badgeUris(
    asset: { base: string; dark?: string },
    tint: string,
  ): { base: string; hover: string } {
    const color = toDataUri(asset.base);
    const mono = toDataUri(asset.dark ?? asset.base, tint);
    const isDark = document.documentElement.classList.contains("dark");
    return isDark ? { base: mono, hover: color } : { base: color, hover: mono };
  }

  function initBadgeState() {
    const tint = currentTint();
    for (const node of rawNodes) {
      const asset = node.badge ? badgeAssets[node.badge] : undefined;
      if (!asset) continue;
      badgeState[node.id] = { ...badgeUris(asset, tint), active: "base" };
    }
    (
      window as Window & { __fuisGraphBadges?: typeof badgeState }
    ).__fuisGraphBadges = badgeState;
  }

  /**
   * Recalcula las variantes de cada badge al cambiar de tema y refresca la
   * imagen del nodo con la variante activa (reposo o hover/active).
   */
  function refreshBadgeVariants() {
    const tint = currentTint();
    for (const node of rawNodes) {
      const state = badgeState[node.id];
      const asset = node.badge ? badgeAssets[node.badge] : undefined;
      if (!state || !asset) continue;
      const next = badgeUris(asset, tint);
      if (next.base === state.base && next.hover === state.hover) continue;
      state.base = next.base;
      state.hover = next.hover;
      nodesDataSet?.update({
        id: node.id,
        shape: "image",
        image: state[state.active],
      });
    }
  }

  function cssVar(name: string): string {
    return getComputedStyle(document.documentElement)
      .getPropertyValue(name)
      .trim();
  }

  function buildOptions() {
    const color = cssVar("--color");
    const title = cssVar("--color-title");
    const node = cssVar("--graph-node") || color;
    const nodeBorder = cssVar("--graph-node-border") || node;
    const nodeHover = cssVar("--graph-node-hover") || color;
    const edge = cssVar("--graph-edge") || cssVar("--border");

    (
      window as Window & {
        __fuisGraphColors?: {
          node: string;
          nodeBorder: string;
          nodeHover: string;
          edge: string;
        };
      }
    ).__fuisGraphColors = { node, nodeBorder, nodeHover, edge };

    const nodeColors = {
      background: node,
      border: nodeBorder,
      // Hover y selección comparten color (`--graph-node-hover`), que ya cambia
      // con el tema; así se evita el azul por defecto de vis en hover.
      highlight: { background: nodeHover, border: nodeHover },
      hover: { background: nodeHover, border: nodeHover },
    };

    return {
      autoResize: true,
      nodes: {
        shape: "dot",
        size: 10,
        borderWidth: 0,
        shadow: { enabled: false },
        font: { color, size: 11, face: "Inter" },
        color: nodeColors,
      },
      groups: {
        center: {
          shape: "star",
          size: 22,
          font: { color: title, size: 15, face: "Inter" },
          color: nodeColors,
        },
        category: {
          shape: "dot",
          size: 16,
          font: { color, size: 13, face: "Inter" },
          color: nodeColors,
        },
        skill: { color: nodeColors },
      },
      edges: {
        color: { color: edge, highlight: edge },
        width: 1.5,
        smooth: { enabled: true, type: "continuous", roundness: 0.5 },
        arrows: {},
      },
      physics: {
        stabilization: true,
        barnesHut: { gravitationalConstant: -2000, springLength: 95 },
      },
      interaction: { hover: true, hideEdgesOnDrag: true },
    };
  }

  /** Nodos con la descripción resuelta para el idioma activo. */
  function nodesForLang(): ResolvedGraphNode[] {
    return rawNodes.map((node) => {
      const badge = node.badge ? badgeState[node.id]?.base : undefined;
      return {
        ...node,
        description: pickLocalized(node.description ?? {}),
        ...(badge ? { shape: "image" as const, image: badge } : {}),
      };
    });
  }

  function showInfo(node: ResolvedGraphNode) {
    if (!infoEl || !infoTitle || !infoText) return;
    currentInfoId = node.id;
    infoTitle.textContent = node.label;
    infoText.textContent = node.description || "";
    infoEl.hidden = false;
  }

  function hideInfo() {
    currentInfoId = null;
    if (infoEl) infoEl.hidden = true;
  }

  function ensureNetwork(): Promise<void> {
    if (network) return Promise.resolve();
    if (ensurePromise) return ensurePromise;

    const netEl = document.getElementById("network");
    if (!netEl) return Promise.resolve();

    ensurePromise = (async () => {
      const { Network, DataSet } = await import("vis-network/standalone");

      nodesDataSet = new DataSet<ResolvedGraphNode>(nodesForLang());
      const edgesDataSet = new DataSet<Edge>(graph.edges as Edge[]);
      refreshBadgeVariants();

      network = new Network(
        netEl,
        { nodes: nodesDataSet, edges: edgesDataSet },
        buildOptions(),
      );

      network.on("click", (params: { nodes?: Array<string | number> }) => {
        const id = params.nodes?.[0];
        if (id === undefined) {
          hideInfo();
          // Click en espacio vacío: vis deselecciona sin emitir deselectNode.
          for (const badgeId of selectedBadgeIds)
            setBadgeImage(badgeId, "base");
          selectedBadgeIds.clear();
          return;
        }
        const node = nodesDataSet?.get(id) as ResolvedGraphNode | null;
        if (node?.description) showInfo(node);
        else hideInfo();
      });

      const setBadgeImage = (id: string | number, target: "base" | "hover") => {
        const nodeId = String(id);
        const state = badgeState[nodeId];
        if (!state || state.active === target) return;
        state.active = target;
        nodesDataSet?.update({
          id: nodeId,
          shape: "image",
          image: target === "hover" ? state.hover : state.base,
        });
      };

      network.on("hoverNode", (params: { node?: string | number }) => {
        if (params.node !== undefined) setBadgeImage(params.node, "hover");
      });

      network.on("blurNode", (params: { node?: string | number }) => {
        const id = params.node;
        if (id !== undefined && !selectedBadgeIds.has(String(id))) {
          setBadgeImage(id, "base");
        }
      });

      network.on("selectNode", (params: { nodes?: Array<string | number> }) => {
        params.nodes?.forEach((id) => {
          selectedBadgeIds.add(String(id));
          setBadgeImage(id, "hover");
        });
      });

      network.on(
        "deselectNode",
        (params: { nodes?: Array<string | number> }) => {
          params.nodes?.forEach((id) => {
            selectedBadgeIds.delete(String(id));
            setBadgeImage(id, "base");
          });
        },
      );

      (window as Window & { __fuisNetwork?: Network }).__fuisNetwork = network;

      network.once("stabilizationIterationsDone", () => {
        (
          window as Window & { __fuisNetworkStabilized?: boolean }
        ).__fuisNetworkStabilized = true;
      });

      const observer = new MutationObserver(() => {
        if (network) {
          network.setOptions(buildOptions());
          network.redraw();
        }
        refreshBadgeVariants();
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
    })();

    return ensurePromise;
  }

  /** Actualiza las descripciones de los nodos y el panel abierto al cambiar de idioma. */
  function applyNodeLang() {
    if (!nodesDataSet) return;
    rawNodes.forEach((node) => {
      const badge = node.badge ? badgeState[node.id]?.base : undefined;
      nodesDataSet?.update({
        id: node.id,
        description: pickLocalized(node.description ?? {}),
        // Reafirma el shape "image": un update parcial reaplica el shape del
        // grupo ("dot") sobre nodos con badge y el logo se convierte en círculo.
        ...(badge ? { shape: "image" as const } : {}),
      });
    });
    if (!infoEl || infoEl.hidden || !currentInfoId) return;
    const node = nodesDataSet.get(currentInfoId) as ResolvedGraphNode | null;
    if (!node) return;
    infoTitle!.textContent = node.label;
    infoText!.textContent = node.description || "";
  }

  syncOnLangChange(applyNodeLang);

  function setup() {
    const host = document.querySelector(".skill-graph");
    infoEl = document.getElementById("network-info");
    infoTitle = document.getElementById("network-info-title");
    infoText = document.getElementById("network-info-text");
    const infoClose = document.getElementById("network-info-close");

    if (!host) return;

    network?.destroy();
    network = null;
    nodesDataSet = null;
    ensurePromise = null;
    (window as Window & { __fuisNetwork?: Network }).__fuisNetwork = undefined;
    (
      window as Window & { __fuisNetworkStabilized?: boolean }
    ).__fuisNetworkStabilized = false;

    controller?.abort();
    controller = new AbortController();

    const onGraphMode = (event: Event) => {
      const active = Boolean((event as CustomEvent).detail?.active);
      host.classList.toggle("is-active", active);
      if (!active) {
        hideInfo();
        return;
      }
      ensureNetwork().then(() => {
        requestAnimationFrame(() => network?.redraw());
      });
    };

    document.addEventListener(GRAPH_MODE_EVENT, onGraphMode, {
      signal: controller.signal,
    });
    window.addEventListener("resize", () => network?.redraw(), {
      signal: controller.signal,
    });
    infoClose?.addEventListener("click", hideInfo, {
      signal: controller.signal,
    });
  }

  setup();
  initBadgeState();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .skill-graph {
    display: none;
    position: relative;
  }
  .skill-graph.is-active {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 460px;
  }
  .card__network {
    height: 100%;
  }
  .card__network-info {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 5;
    max-width: 75%;
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.75rem 1.25rem 0.75rem 1rem;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
  }
  .card__network-info h4 {
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-title);
    padding-right: 1rem;
  }
  .card__network-info p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color);
  }
  .card__network-info button {
    position: absolute;
    top: 0.375rem;
    right: 0.5rem;
    background: none;
    border: none;
    color: var(--color);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
  }
  .card__network-info button:hover {
    background-color: var(--bg-hover);
    color: var(--color-hover);
  }
  @media screen and (width >= 475px) {
    .card__network {
      height: 460px;
    }
  }
</style>
