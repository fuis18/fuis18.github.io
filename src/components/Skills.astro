---
import skillsData from "@/data/skills.json";
const skills = [...skillsData, ...skillsData];
---

<div class="scroll">
  <div class="tags" data-size="lg">
    {skills.map((skill) => <span class="tag">{skill}</span>)}
  </div>
</div>

<style>
  .scroll {
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      rgba(0, 0, 0, 1) 10%,
      rgba(0, 0, 0, 1) 90%,
      rgba(0, 0, 0, 0)
    );
  }

  .tags {
    animation: scroll 30s linear infinite;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
