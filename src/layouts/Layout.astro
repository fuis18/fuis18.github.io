---
import Head from "./Head.astro";
import "@/styles/globals.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const { title, description } = Astro.props;
import { SITE } from "@/consts";
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} - ${SITE.TITLE}`} description={description} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<script>
  import { updateTranslations } from "@/lib/i18n";

  function init() {
    const lang = localStorage.getItem("lang") || (navigator.language.startsWith("es") ? "es" : "en");
    document.documentElement.lang = lang;
    updateTranslations();
    const select = document.getElementById("lang-select") as HTMLSelectElement;
    if (select) select.value = lang;
  }

  init();
  document.addEventListener("lang-change", init);
  document.addEventListener("astro:page-load", init);
</script>
