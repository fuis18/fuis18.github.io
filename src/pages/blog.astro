---
import Layout from "@/layouts/Layout.astro";
import { m } from "@/paraglide/messages";
import BlogCard from "@/components/BlogCard.astro";
---

<Layout title="Home" description="My website">
  <main transition:animate="slide">
    <h1 data-i18n="blog-title" data-textfx>{m.blog_title()}</h1>
    <div class="blog-container card-handler">
      <BlogCard />
      <BlogCard />
      <BlogCard />
      <BlogCard />
    </div>
  </main>
</Layout>

<script>
  import { m } from "@/paraglide/messages";
  import { syncOnLangChange } from "@/lib/i18n";

  function syncTitle() {
    const heading = document.querySelector<HTMLElement>(
      "[data-i18n='blog-title']",
    );
    if (heading) heading.textContent = m.blog_title();
  }

  syncOnLangChange(syncTitle);
  document.addEventListener("astro:page-load", syncTitle);
</script>

<style>
  @media screen and (width >= 1000px) {
    .blog-container {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
