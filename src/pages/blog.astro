---
import Layout from "@/layouts/Layout.astro";
import { m } from "@/paraglide/messages";
import BlogCard from "@/components/BlogCard.astro";
import { getBlogPosts, toPayload } from "@/lib/blog";
import { serializePayload } from "@/lib/blogClient";

const posts = await getBlogPosts();
const payloadJson = serializePayload(posts.map(toPayload));
---

<Layout title="Blog" description="My website" width="large">
  <main transition:animate="slide">
    <h1 data-i18n="blog-title" data-textfx>{m.blog_title()}</h1>
    <div class="blog-container card-handler">
      {
        posts.map((post, index) => (
          <div
            class="blog-item"
            data-side={index % 2 === 0 ? "start" : "end"}
            data-post-index={index}
          >
            <span class="blog-item__dot" aria-hidden="true" />
            <BlogCard
              slug={post.slug}
              title={post.title}
              description={post.description}
              date={post.dateLabel}
              isoDate={post.isoDate}
              readingTime={post.readingTime}
              tags={post.tags}
            />
          </div>
        ))
      }
    </div>
    <script
      type="application/json"
      data-blog-payload
      is:inline
      set:html={payloadJson}
    />
  </main>
</Layout>

<script>
  import { m } from "@/paraglide/messages";
  import { syncOnLangChange } from "@/lib/i18n";
  import {
    applyPostFields,
    readPayloadList,
    type BlogPostPayload,
  } from "@/lib/blogClient";

  function syncPosts() {
    const heading = document.querySelector<HTMLElement>(
      "[data-i18n='blog-title']",
    );
    if (heading) heading.textContent = m.blog_title();

    const posts = readPayloadList<BlogPostPayload>("[data-blog-payload]");
    document
      .querySelectorAll<HTMLElement>("[data-post-index]")
      .forEach((card) => {
        const post = posts[Number(card.dataset.postIndex)];
        if (post) applyPostFields(card, post);
      });
  }

  syncOnLangChange(syncPosts);
  document.addEventListener("astro:page-load", syncPosts);
</script>

<style>
  .blog-container {
    --rail-w: 2px;
    --dot: 0.625rem;
    --gap: 1rem;

    position: relative;
    padding-left: calc(var(--dot) + var(--gap));
  }

  .blog-container::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: calc(var(--dot) / 2 - var(--rail-w) / 2);
    width: var(--rail-w);
    background-color: var(--border);
  }

  .blog-item {
    position: relative;
  }

  .blog-item__dot {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    left: calc(-1 * (var(--dot) + var(--gap)));
    width: var(--dot);
    height: var(--dot);
    border: 2px solid var(--border);
    border-radius: 50%;
    background-color: var(--bg-primary);
  }

  @media screen and (width >= 1000px) {
    .blog-container {
      grid-template-columns: 1fr 1fr;
      --gap: 3rem;
      column-gap: calc(var(--gap) * 2);
      padding-left: 0;
    }

    .blog-container::before {
      left: 50%;
      margin-left: calc(var(--rail-w) / -2);
    }

    .blog-item__dot {
      left: auto;
    }

    .blog-item[data-side="start"] .blog-item__dot {
      top: 25%;
    }

    .blog-item[data-side="end"] .blog-item__dot {
      top: 75%;
    }

    .blog-item[data-side="start"] .blog-item__dot {
      right: calc(-1 * (var(--gap) + var(--dot) / 2));
    }

    .blog-item[data-side="end"] .blog-item__dot {
      left: calc(-1 * (var(--gap) + var(--dot) / 2));
    }
  }

  .blog-item:hover .blog-item__dot {
    border-color: var(--color-hover);
    background-color: var(--color-hover);
  }
</style>
