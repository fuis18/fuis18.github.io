---
import { render, type CollectionEntry } from "astro:content";
import { getBlogPostsWithEntries } from "@/lib/blog";
import { DEFAULT_LANG } from "@/lib/i18n";

export async function getStaticPaths() {
  const posts = await getBlogPostsWithEntries();
  return posts.flatMap(({ post, entries }) =>
    Object.entries(entries)
      .filter(([lang]) => lang !== DEFAULT_LANG)
      .map(([lang, entry]) => ({
        params: { slug: post.slug, lang },
        props: { entry },
      })),
  );
}

const { entry } = Astro.props as { entry: CollectionEntry<"blog"> };
const { Content } = await render(entry);
const { lang } = Astro.params;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="prose">
      <Content />
    </div>
  </body>
</html>
