---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ImageZoom from "@/components/ImageZoom.astro";
import { m } from "@/paraglide/messages";
import { projects } from "@/lib/projects";
import { resolveProjectImage } from "@/lib/projectImages";

const projectCards = projects.map((project) => ({
  ...project,
  image: resolveProjectImage(project.image),
}));
const isEven = projects.length % 2 === 0;
---

<Layout title="Projects" description="My website" background="true">
  <main transition:animate="slide">
    <h1 data-i18n="projects-title">{m.projects_title()}</h1>
    <div class:list={["project-container", { "even-count": isEven }]}>
      {
        projectCards.map((project, index) => {
          const alt = Object.values(project.title)[0] ?? "";
          const loading = index < 8 ? "eager" : "lazy";
          return (
            <div class="project-item" data-project-index={index}>
              <ImageZoom src={project.image} alt={alt} loading={loading} />
              <ProjectCard
                title={project.title}
                description={project.description}
                repo={project.repo}
                website={project.website}
                tags={project.tags}
                date={project.date}
              />
            </div>
          );
        })
      }
    </div>
  </main>
</Layout>

<script>
  import { m } from "@/paraglide/messages";
  import { projects } from "@/lib/projects";
  import { DEFAULT_LANG, getLang, syncOnLangChange } from "@/lib/i18n";

  function syncProjects() {
    const heading = document.querySelector<HTMLElement>(
      "[data-i18n='projects-title']",
    );
    if (heading) heading.textContent = m.projects_title();

    document
      .querySelectorAll<HTMLElement>("[data-project-index]")
      .forEach((card) => {
        const index = Number(card.dataset.projectIndex);
        const project = projects[index];
        if (!project) return;
        card
          .querySelectorAll<HTMLElement>("[data-project-field]")
          .forEach((el) => {
            const field = el.dataset.projectField as
              | "title"
              | "description"
              | "date";
            const localized = project[field];
            el.textContent = localized[getLang()] ?? localized[DEFAULT_LANG];
          });
      });
  }

  syncOnLangChange(syncProjects);
  document.addEventListener("astro:page-load", syncProjects);
</script>

<style>
  main {
    max-width: max-content;
    margin-inline: 1rem;
    margin-top: 0;
  }
  .project-container {
    grid-template-columns: 1fr;
    display: grid;
    gap: 1.5rem;
  }
  .project-item {
    height: min-content;
  }

  .project-item:nth-child(2n) {
    justify-self: end;
  }

  .project-item:hover {
    translate: 0 -0.25rem;
  }

  :global(footer) {
    max-width: none;
  }

  @media screen and (width >= 600px) {
    main {
      margin-inline: 2rem;
    }
  }
  @media screen and (width >= 670px) {
    .project-container {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media screen and (width >= 1010px) {
    .project-container {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1rem;
    }
  }
  @media screen and (width >= 1400px) {
    .project-container {
      grid-template-columns: 1fr;
    }
    .project-item {
      width: 60%;
      display: grid;
      grid-template-columns: 2fr 3fr;
    }
  }
  @media screen and (width >= 1720px) {
    .project-container {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .project-item {
      width: 100%;
    }
    .project-container.even-count {
      padding-bottom: 5rem;
    }
    .project-item:nth-child(2n) {
      transform: translateY(50%);
    }
  }
  @media screen and (width >= 1800px) {
    main {
      margin-inline: 5rem;
    }
  }
</style>