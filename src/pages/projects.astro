---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import projects from "@/data/projects.json";
---

<Layout title="Projects" description="My website">
  <main transition:animate="slide">
    <h1>Projects</h1>
    <div class="project-container">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            href={project.href}
            image={project.image}
            tags={project.tags}
            date={project.date}
          />
        ))
      }
    </div>
  </main>
</Layout>

<style>
  main {
    max-width: max-content;
    margin-inline: 1rem;
    margin-top: 0;
  }
  .project-container {
    grid-template-columns: 1fr;
    display: grid;
    gap: 1.5rem;
  }

  :global(.project-container .project-card:nth-child(2n)) {
    justify-self: end;
  }

  :global(footer) {
    max-width: none;
  }

  @media screen and (width >= 600px) {
    main {
      margin-inline: 2rem;
    }
  }
  @media screen and (width >= 700px) {
    .project-container {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media screen and (width >= 900px) {
    .project-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media screen and (width >= 1720px) {
    .project-container {
      grid-template-columns: 1fr 1fr;
      padding-bottom: 0.5rem;
    }
    :global(.project-container .project-card:nth-child(2n)) {
      transform: translateY(50%);
    }
  }
  @media screen and (width >= 1810px) {
    main {
      margin-inline: 5rem;
    }
  }
</style>
